{
  "info": {
    "name": "Hermanos Jota — API de productos (CRUD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el Collection Runner contra una API conectada a MongoDB. \"Crear\" guarda el _id en la variable productId, que usan las demás solicitudes; \"Eliminar\" lo borra al final."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "000000000000000000000000"
    }
  ],
  "item": [
    {
      "name": "Listado — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Es un array con _id y nombre\", function () { const l = pm.response.json(); pm.expect(l).to.be.an(\"array\"); l.forEach(function (p) { pm.expect(p).to.have.property(\"_id\"); pm.expect(p).to.have.property(\"nombre\"); pm.expect(p).to.have.property(\"precio\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear — 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mesa de prueba\",\n  \"descripcion\": \"Producto de prueba\",\n  \"precio\": 12345,\n  \"stock\": 2,\n  \"imagenUrl\": \"/assets/images/mesa-comedor-pampa.png\"\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Devuelve el producto creado\", function () { const p = pm.response.json(); pm.expect(p).to.have.property(\"_id\"); pm.expect(p.nombre).to.eql(\"Mesa de prueba\"); pm.collectionVariables.set(\"productId\", p._id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear sin nombre ni precio — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"incompleto\"\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(400); pm.expect(b.error).to.be.a(\"string\").and.match(/obligatorio/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Es el producto pedido\", function () { pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get(\"productId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle inexistente — 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{missingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(404); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle con _id mal formado — 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(400); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar — 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"precio\": 20000,\n  \"stock\": 7\n}"
        },
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Devuelve el documento actualizado\", function () { const p = pm.response.json(); pm.expect(p.precio).to.eql(20000); pm.expect(p.stock).to.eql(7); pm.expect(p.nombre).to.eql(\"Mesa de prueba\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar con precio negativo — 400",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"precio\": -1\n}"
        },
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(400); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar inexistente — 404",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"precio\": 1\n}"
        },
        "url": "{{baseUrl}}/api/productos/{{missingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(404); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar — 200",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar de nuevo — 404",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(404); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    }
  ]
}
