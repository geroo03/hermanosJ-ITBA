{
  "info": {
    "name": "Hermanos Jota — API de productos (CRUD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el Collection Runner contra la API completa (src/server.js) conectada a MongoDB. Las lecturas (GET) son públicas; antes de escribir, registra/inicia sesión para guardar el JWT en la variable `token` y lo envía como `Authorization: Bearer {{token}}` en POST, PUT y DELETE. También verifica 401 cuando falta el token."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "productos.postman@correo.com"
    },
    {
      "key": "password",
      "value": "secreto123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "000000000000000000000000"
    }
  ],
  "item": [
    {
      "name": "Listado público — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Es un array con _id y nombre\", function () { const l = pm.response.json(); pm.expect(l).to.be.an(\"array\"); l.forEach(function (p) { pm.expect(p).to.have.property(\"_id\"); pm.expect(p).to.have.property(\"nombre\"); pm.expect(p).to.have.property(\"precio\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear sin token — 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mesa sin sesión\",\n  \"precio\": 12345\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(401); pm.expect(b.error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Autenticación — Registrar usuario (201 o 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Productos\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201 (creado) o 409 (ya existe)\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.expect(data.token).to.be.a(\"string\"); pm.collectionVariables.set(\"token\", data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Autenticación — Login (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Devuelve token JWT\", function () { const data = pm.response.json(); pm.expect(data.token).to.be.a(\"string\"); pm.collectionVariables.set(\"token\", data.token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear — 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mesa de prueba\",\n  \"descripcion\": \"Producto de prueba\",\n  \"precio\": 12345,\n  \"stock\": 2,\n  \"imagenUrl\": \"/assets/images/mesa-comedor-pampa.png\"\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Devuelve el producto creado\", function () { const p = pm.response.json(); pm.expect(p).to.have.property(\"_id\"); pm.expect(p.nombre).to.eql(\"Mesa de prueba\"); pm.collectionVariables.set(\"productId\", p._id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear sin nombre ni precio — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"incompleto\"\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Error con formato { error, status }\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(400); pm.expect(b.error).to.be.a(\"string\").and.match(/obligatorio/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle público — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Es el producto pedido\", function () { pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get(\"productId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle inexistente — 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/{{missingId}}"
